# Copy to .dev.vars for local development. Never commit .dev.vars.
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
# Optional: register commands to one server instantly instead of globally
DISCORD_DEV_GUILD_ID=

# GitHub App (Settings -> Developer settings -> GitHub Apps). Without these,
# reports are acknowledged in Discord but no issue is filed.
GITHUB_APP_ID=
# The downloaded .pem on one line, with line breaks written as \n
GITHUB_APP_PRIVATE_KEY=
# The GitHub App's webhook secret (App settings -> Webhook). Needed for agent:go.
GITHUB_WEBHOOK_SECRET=

# AI triage (optional). Set one provider's key; without a key, issues are filed untriaged.
#   anthropic: Claude, defaults to claude-opus-5-5
#   openai:    GPT via Chat Completions, TRIAGE_MODEL is required
TRIAGE_PROVIDER=
TRIAGE_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Server-side coding agent (Claude Managed Agents, uses ANTHROPIC_API_KEY).
# Create the IDs once with `npm run setup-agent`.
MANAGED_AGENT_ID=
MANAGED_ENVIRONMENT_ID=
# Spend cap per agent session in US cents (default 200 = $2)
AGENT_BUDGET_CENTS=

# Usage limits (optional). Empty means no limit; months are UTC calendar months.
#   reports per Discord user per hour, reports per server per month, agent runs per month
LIMIT_REPORTS_PER_USER_HOUR=
LIMIT_REPORTS_PER_MONTH=
LIMIT_AGENT_RUNS_PER_MONTH=
# Claude Console -> Webhooks: endpoint https://<worker>/anthropic/webhook, events
# session.status_idled, session.status_terminated, session.budget_reached
ANTHROPIC_WEBHOOK_SIGNING_KEY=
